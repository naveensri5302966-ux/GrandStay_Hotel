# Base URL for backend REST API (Genuine Express Server on port 5000)
VITE_API_BASE_URL=http://localhost:5000/api

# When false, uses genuine REST network requests (Fetch/XHR in DevTools)
# When true, falls back to the client-side mock adapter
VITE_USE_MOCK_API=false

# Cryptographically strong JWT Signing Secret (Minimum 32 characters - REQUIRED in production)
JWT_SECRET=your_strong_jwt_secret_minimum_32_characters_here

# Server environment & CORS configuration
NODE_ENV=production
CLIENT_URL=https://your-production-app.com
ALLOWED_ORIGINS=https://your-production-app.com,https://admin.your-production-app.com
