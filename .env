# Base URL for backend REST API (Genuine Express Server on port 5000)
VITE_API_BASE_URL=http://localhost:5000/api
VITE_USE_MOCK_API=false

# Cryptographically strong JWT Signing Secret (Minimum 32 characters)
JWT_SECRET=super_secret_grandstay_jwt_token_key_2026_very_long_and_secure

# Development environment & CORS configuration
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
